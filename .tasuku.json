  "context": {
    "learnings": [
      {
        "id": "f53a47",
        "text": "CLI command is 'tk' to avoid collisions",
        "created_at": "0001-01-01T00:00:00Z"
      },
      {
        "id": "67a550",
        "text": "Using flock for file locking (works on macOS/Linux)",
        "created_at": "0001-01-01T00:00:00Z"
      },
      {
        "id": "3a1aa3",
        "text": "JSON chosen over YAML for faster parsing and less ambiguity",
        "created_at": "0001-01-01T00:00:00Z"
      },
      {
        "id": "91158f",
        "text": "MCP server will use stdio mode for Claude Code integration",
        "created_at": "0001-01-01T00:00:00Z"
      },
      {
        "id": "2f15dd",
        "text": "taskResult type in MCP server is local - use JSON marshal/unmarshal for testing",
        "created_at": "2026-01-05T01:51:12.148186Z"
      },
      {
        "id": "e4cbb7",
        "text": "CLI/MCP Parity Principle: Every CLI command must have a corresponding MCP tool. Agents interact via MCP, humans via CLI - same capabilities, different interfaces. When adding new CLI commands, always add the MCP tool equivalent.",
        "is_rule": true,
        "created_at": "2026-01-05T04:34:19.50315Z"
      }
    ],
    "decisions": [
      {
        "id": "language",
        "chose": "Go",
        "over": [
          "TypeScript",
          "Rust"
        ],
        "because": "Single binary, good concurrency, fast startup for CLI",
        "created_at": "0001-01-01T00:00:00Z"
      },
      {
        "id": "data-format",
        "chose": "JSON",
        "over": [
          "YAML",
          "TOML",
          "SQLite"
        ],
        "because": "Faster parsing, unambiguous, better for programmatic access",
        "created_at": "0001-01-01T00:00:00Z"
      },
      {
        "id": "agent-model",
        "chose": "Hierarchical with parallel workers",
        "over": [
          "Pure parallel",
          "Sequential handoff"
        ],
        "because": "Best for token efficiency - workers get scoped context",
        "created_at": "0001-01-01T00:00:00Z"
      },
      {
        "id": "grove-over-native",
        "chose": "Grove integration",
        "over": [
          "Native worktree support"
        ],
        "because": "Single responsibility - Tasuku manages tasks, Grove manages worktrees. Avoids duplication and leverages existing Grove infrastructure.",
        "created_at": "0001-01-01T00:00:00Z"
      },
      {
        "id": "v2-scope",
        "chose": "Local-first features",
        "over": [
          "Webhooks",
          "GitHub Actions",
          "remote sync"
        ],
        "because": "Tasuku is local-first with JSON file. Server-dependent features don't fit the philosophy. Focus on agent coordination, tags, time tracking, custom fields.",
        "created_at": "0001-01-01T00:00:00Z"
      },
      {
        "id": "cli-mcp-parity",
        "chose": "Maintain 1:1 parity between CLI commands and MCP tools",
        "over": [
          "MCP as subset of CLI",
          "MCP with different capabilities",
          "CLI-only features"
        ],
        "because": "Agent-first design means agents must be able to do everything humans can. If CLI has a capability that MCP lacks, agents are second-class citizens. This defeats the purpose of Tasuku.",
        "created_at": "2026-01-05T04:34:19.542423Z"
      }
    ],
    "notes": {
      "grove-integration": [
        {
          "id": "12d8fb",
          "text": "Approach: Auto-detect Grove availability. If Grove present, use grove_new for full experience (worktree + dev server). If not, fall back to native git worktree commands for basic isolation. Print tip about Grove for full experience.",
          "created_at": "0001-01-01T00:00:00Z"
        },
        {
          "id": "48aaf5",
          "text": "Detection: Check if Grove MCP is configured in Claude settings or attempt grove_list call. Native fallback uses git worktree add ../tasuku-{task-id} -b {task-id}",
          "created_at": "0001-01-01T00:00:00Z"
        }
      ],
      "tui-pty-tests": [
        {
          "id": "7bb9c9",
          "text": "PTY tests have timing issues - output capture race condition. Infrastructure in place, may need debugging.",
          "created_at": "2026-01-05T03:42:52.086807Z"
        }
      ],
      "v2-agent-coordination": [
        {
          "id": "dfa601",
          "text": "Commands: tk task claim \u003cid\u003e, tk task release \u003cid\u003e, tk task who. Use owner field + timestamps. Consider lock timeout for stale claims.",
          "created_at": "2026-01-05T01:39:55.247041Z"
        }
      ],
      "v2-gh-pr": [
        {
          "id": "309b31",
          "text": "Simple wrapper: gh pr create --title \u003cdesc\u003e --body \u003cnotes\u003e. Check gh is installed. Auto-detect current branch task ID from branch name.",
          "created_at": "2026-01-05T01:39:59.473021Z"
        }
      ],
      "v2-tags-labels": [
        {
          "id": "56aab1",
          "text": "Add Tags []string to Task struct. Commands: tk task add --tag x,y, tk task list --tag x, tk task tag \u003cid\u003e add/remove \u003ctag\u003e. Consider tag autocomplete.",
          "created_at": "2026-01-05T01:39:56.707292Z"
        }
      ],
      "v2-time-tracking": [
        {
          "id": "473f9d",
          "text": "Add TimeEntries []TimeEntry to Task. Commands: tk task time start/stop/show \u003cid\u003e. Calculate total duration. Consider Pomodoro-style features.",
          "created_at": "2026-01-05T01:39:58.361688Z"
        }
      ]
    }
  },

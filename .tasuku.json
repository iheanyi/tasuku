  "context": {
    "learnings": [
      "CLI command is 'tk' to avoid collisions",
      "Using flock for file locking (works on macOS/Linux)",
      "JSON chosen over YAML for faster parsing and less ambiguity",
      "MCP server will use stdio mode for Claude Code integration",
      "taskResult type in MCP server is local - use JSON marshal/unmarshal for testing",
      "-h",
      "--help"
    ],
    "decisions": [
      {
        "id": "language",
        "chose": "Go",
        "over": [
          "TypeScript",
          "Rust"
        ],
        "because": "Single binary, good concurrency, fast startup for CLI"
      },
      {
        "id": "data-format",
        "chose": "JSON",
        "over": [
          "YAML",
          "TOML",
          "SQLite"
        ],
        "because": "Faster parsing, unambiguous, better for programmatic access"
      },
      {
        "id": "agent-model",
        "chose": "Hierarchical with parallel workers",
        "over": [
          "Pure parallel",
          "Sequential handoff"
        ],
        "because": "Best for token efficiency - workers get scoped context"
      },
      {
        "id": "grove-over-native",
        "chose": "Grove integration",
        "over": [
          "Native worktree support"
        ],
        "because": "Single responsibility - Tasuku manages tasks, Grove manages worktrees. Avoids duplication and leverages existing Grove infrastructure."
      }
    ],
    "notes": {
      "grove-integration": [
        "Approach: Auto-detect Grove availability. If Grove present, use grove_new for full experience (worktree + dev server). If not, fall back to native git worktree commands for basic isolation. Print tip about Grove for full experience.",
        "Detection: Check if Grove MCP is configured in Claude settings or attempt grove_list call. Native fallback uses git worktree add ../tasuku-{task-id} -b {task-id}"
      ]
    }
  }

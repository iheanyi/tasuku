{
  "$schema": "https://opencode.ai/schemas/opencode.json",
  "name": "tasuku-opencode-example",
  "description": "Example OpenCode configuration with Tasuku integration",
  "plugins": [
    {
      "name": "tasuku",
      "path": "./.opencode/plugin/tasuku.js"
    }
  ],
  "mcpServers": {
    "tasuku": {
      "command": "tk",
      "args": ["mcp", "start"],
      "env": {}
    }
  }
}
